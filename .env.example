# ---------- Firebase (cliente / navegador) ----------
# Console Firebase > Configurações do projeto > Seus apps > App Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase Admin (servidor) ----------
# Console Firebase > Configurações > Contas de serviço > Gerar nova chave privada
FIREBASE_PROJECT_ID=seu-projeto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
# Cole a chave entre aspas, mantendo os \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------- Z-API ----------
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
# Painel Z-API > Segurança > Token de segurança da conta
ZAPI_CLIENT_TOKEN=

# Segredo que vai na URL do webhook: /api/webhooks/zapi?secret=ESSE_VALOR
ZAPI_WEBHOOK_SECRET=troque-por-um-valor-aleatorio

# Segredo do cron de encerramento automático (Vercel Cron / cron-job.org)
CRON_SECRET=troque-por-outro-valor-aleatorio
